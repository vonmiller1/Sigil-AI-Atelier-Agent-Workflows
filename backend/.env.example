# Express API — copy to `.env` and fill in values (never commit `.env`).

PORT=5000
NODE_ENV=development

# Required for MongoDB persistence
MONGO_URI=mongodb://127.0.0.1:27017/yakkay-ai

# Required in production; use a long random string in development too
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRE=30d

# Must match the AI engine ENCRYPTION_KEY exactly
ENCRYPTION_KEY=replace-with-a-separate-secret

# Public URL of this API (OAuth redirect templates may reference ${BACKEND_URL})
BACKEND_URL=http://localhost:5000

# FastAPI engine base URL (no trailing slash)
PYTHON_ENGINE_URL=http://localhost:8000

# Optional — Google OAuth (Gmail integration)
Gmail_ClientID=
Gmail_ClientSecret=
Gmail_REDIRECT_URI=${BACKEND_URL}/api/auth/google/callback

# Optional — Microsoft OAuth
MS_ClientID=
MS_SecretID=
MS_REDIRECT_URI=${BACKEND_URL}/api/auth/microsoft/callback
