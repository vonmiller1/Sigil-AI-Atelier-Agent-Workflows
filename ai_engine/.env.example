# FastAPI AI engine — copy to `.env` and fill in values (never commit `.env`).

# Must match backend ENCRYPTION_KEY for decrypting stored credentials
ENCRYPTION_KEY=replace-with-the-same-value-as-backend

MONGO_URI=mongodb://127.0.0.1:27017/yakkay-ai

# Backend API URL for status callbacks (no trailing slash)
BACKEND_URL=http://localhost:5000

# Provider keys — set only for models and integrations you use
GEMINI_API_KEY=
GOOGLE_API_KEY=
